<phone:PhoneApplicationPage
    x:Class="MetroPinry.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="False">

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <!-- Заголовок панорамы в нижнем регистре (канон Metro) -->
        <phone:Panorama Title="metropinry">
            <phone:Panorama.Background>
                <ImageBrush ImageSource="/MetroPinry;component/Assets/PanoramaDarkGrain.png" 
                            Opacity="0.4" 
                            Stretch="UniformToFill"/>
            </phone:Panorama.Background>

            <!-- СЕКЦИЯ 1: Лента всех пинов -->
            <phone:PanoramaItem Header="feed" Width="380">
                <phone:LongListSelector x:Name="FeedList"
                                        Margin="12,0,0,0"
                                        ItemsSource="{Binding RecentPins}"
                                        SelectionChanged="OnPinSelectionChanged">
                    <phone:LongListSelector.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,16,14" Background="#1AFFFFFF">
                                <StackPanel>
                                    <!-- Квадратный контейнер 350x350 -->
                                    <Grid Width="350" Height="350" Background="#11FFFFFF">
                                        <Image Stretch="UniformToFill">
                                            <Image.Source>
                                                <BitmapImage UriSource="{Binding DisplayThumbnailUrl}" CreateOptions="BackgroundCreation"/>
                                            </Image.Source>
                                        </Image>
                                    </Grid>

                                    <TextBlock Text="{Binding Description}" 
                                               Margin="10,8" 
                                               MaxHeight="42"
                                               TextWrapping="Wrap"
                                               TextTrimming="WordEllipsis" 
                                               Style="{StaticResource PhoneTextNormalStyle}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </phone:LongListSelector.ItemTemplate>
                </phone:LongListSelector>
            </phone:PanoramaItem>

            <!-- СЕКЦИЯ 2: Доски / Коллекции (сетка плиток) -->
            <phone:PanoramaItem Header="boards" Width="420">
                <phone:LongListSelector Margin="12,0,0,0"
                                        ItemsSource="{Binding Boards}"
                                        LayoutMode="Grid" 
                                        GridCellSize="180,180"
                                        SelectionChanged="OnBoardSelectionChanged">
                    <phone:LongListSelector.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="170" Height="170" 
                                  Margin="0,0,10,10" 
                                  Background="{StaticResource PhoneAccentBrush}">

                                <!-- Обложка доски через нативный BitmapImage -->
                                <Image Stretch="UniformToFill">
                                    <Image.Source>
                                        <BitmapImage UriSource="{Binding CoverImageUrl}" CreateOptions="BackgroundCreation"/>
                                    </Image.Source>
                                </Image>

                                <!-- Затемнение снизу для читаемости текста в стиле Metro -->
                                <Border VerticalAlignment="Bottom" Background="#B2000000" Padding="8,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" 
                                                   FontWeight="Bold" 
                                                   FontSize="20" 
                                                   Foreground="White"
                                                   TextTrimming="WordEllipsis"/>
                                        <TextBlock Text="{Binding PinsCount, StringFormat='{}{0} pins'}" 
                                                   Opacity="0.85" 
                                                   FontSize="14"
                                                   Foreground="White"
                                                   Style="{StaticResource PhoneTextSubtleStyle}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </phone:LongListSelector.ItemTemplate>
                </phone:LongListSelector>
            </phone:PanoramaItem>

            <!-- СЕКЦИЯ 3: Профиль и действия -->
            <phone:PanoramaItem Header="me">
                <StackPanel Margin="12,0,24,0">
                    <!-- Аватар Gravatar -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                        <Border Width="72" Height="72" Background="{StaticResource PhoneAccentBrush}">
                            <Image Source="{Binding CurrentUser.AvatarUrl}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUser.Username}" Style="{StaticResource PhoneTextTitle2Style}"/>
                            <TextBlock Text="{Binding CurrentUser.Email}" Style="{StaticResource PhoneTextSubtleStyle}"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Content="my saved pins" Margin="-12,0,0,6" Click="OnMyPinsClick"/>
                    <Button Content="create new board" Margin="-12,0,0,6" Click="OnCreateBoardClick"/>
                    <Button Content="server settings" Margin="-12,0,0,6" Click="OnSettingsClick"/>
                </StackPanel>
            </phone:PanoramaItem>
        </phone:Panorama>
    </Grid>

    <!-- Панель действий -->
    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar IsVisible="True" IsMenuEnabled="True" Mode="Minimized">
            <shell:ApplicationBarIconButton IconUri="/Assets/AppBar/add.png" 
                                             Text="add pin" 
                                             Click="OnAddPinAppBarClick"/>
            <shell:ApplicationBarIconButton IconUri="/Assets/AppBar/refresh.png" 
                                             Text="refresh" 
                                             Click="OnRefreshAppBarClick"/>
        </shell:ApplicationBar>
    </phone:PhoneApplicationPage.ApplicationBar>

</phone:PhoneApplicationPage>