<phone:PhoneApplicationPage
    x:Name="RootPage"
    x:Class="MetroPinry.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    xmlns:local="clr-namespace:MetroPinry"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="False">

    <phone:PhoneApplicationPage.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </phone:PhoneApplicationPage.Resources>

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <phone:Panorama x:Name="MainPanorama" 
                        Title="{Binding Path=LocalizedResources.AppTitle, Source={StaticResource LocalizedStrings}}" 
                        SelectionChanged="MainPanorama_SelectionChanged" 
                        Loaded="MainPanorama_Loaded">
            <phone:Panorama.Background>
                <ImageBrush ImageSource="/MetroPinry;component/Assets/PanoramaDarkGrain.png" 
                            Opacity="0.4" 
                            Stretch="UniformToFill"/>
            </phone:Panorama.Background>

            <!-- СЕКЦИЯ 1: Лента всех пинов -->
            <phone:PanoramaItem Header="{Binding Path=LocalizedResources.PanoramaFeed, Source={StaticResource LocalizedStrings}}" Width="380">
                <phone:LongListSelector x:Name="FeedList"
                                        Margin="12,0,0,0"
                                        ItemsSource="{Binding RecentPins}"
                                        ItemRealized="FeedList_ItemRealized"
                                        SelectionChanged="OnPinSelectionChanged">

                    <phone:LongListSelector.ListFooterTemplate>
                        <DataTemplate>
                            <Grid Height="90" 
                                  Margin="0,16,16,40"
                                  HorizontalAlignment="Stretch"
                                  Visibility="{Binding HasReachedEnd, ElementName=RootPage, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="- end -" 
                                           FontSize="22" 
                                           FontWeight="Light"
                                           FontFamily="Segoe WP"
                                           Opacity="0.45"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource PhoneForegroundBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </phone:LongListSelector.ListFooterTemplate>

                    <phone:LongListSelector.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,16,14" 
                                    Background="#1AFFFFFF"
                                    toolkit:TiltEffect.SuppressTilt="True"
                                    Hold="OnItemHold">
                                <toolkit:ContextMenuService.ContextMenu>
                                    <toolkit:ContextMenu Opened="OnContextMenuOpened">
                                        <toolkit:MenuItem Header="{Binding Path=LocalizedResources.Edit, Source={StaticResource LocalizedStrings}}" Click="OnEditPinContextClick"/>
                                        <toolkit:MenuItem Header="{Binding Path=LocalizedResources.Delete, Source={StaticResource LocalizedStrings}}" Click="OnDeletePinContextClick"/>
                                    </toolkit:ContextMenu>
                                </toolkit:ContextMenuService.ContextMenu>
                                <StackPanel>
                                    <Image Width="350" 
                                           Height="350" 
                                           HorizontalAlignment="Center" 
                                           Stretch="UniformToFill">
                                        <Image.Source>
                                            <BitmapImage UriSource="{Binding DisplayStandardUrl}" DecodePixelWidth="400"/>
                                        </Image.Source>
                                    </Image>

                                    <TextBlock Text="{Binding Description}" 
                                               Margin="10,8" 
                                               MaxHeight="42"
                                               TextWrapping="Wrap"
                                               TextTrimming="WordEllipsis" 
                                               Style="{StaticResource PhoneTextNormalStyle}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </phone:LongListSelector.ItemTemplate>
                </phone:LongListSelector>
            </phone:PanoramaItem>

            <!-- СЕКЦИЯ 2: Все публичные доски -->
            <phone:PanoramaItem Header="{Binding Path=LocalizedResources.PanoramaBoards, Source={StaticResource LocalizedStrings}}" Width="420">
                <phone:LongListSelector Margin="12,0,0,0"
                                        ItemsSource="{Binding Boards}"
                                        LayoutMode="Grid" 
                                        GridCellSize="180,180"
                                        SelectionChanged="OnBoardSelectionChanged">
                    <phone:LongListSelector.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="170" Height="170" 
                                  Margin="0,0,10,10" 
                                  Background="{StaticResource PhoneAccentBrush}"
                                  toolkit:TiltEffect.SuppressTilt="True"
                                  Hold="OnItemHold">
                                <toolkit:ContextMenuService.ContextMenu>
                                    <toolkit:ContextMenu Opened="OnContextMenuOpened">
                                        <toolkit:MenuItem Header="{Binding Path=LocalizedResources.Edit, Source={StaticResource LocalizedStrings}}" Click="OnEditBoardContextClick"/>
                                        <toolkit:MenuItem Header="{Binding Path=LocalizedResources.Delete, Source={StaticResource LocalizedStrings}}" Click="OnDeleteBoardContextClick"/>
                                    </toolkit:ContextMenu>
                                </toolkit:ContextMenuService.ContextMenu>

                                <Image Stretch="UniformToFill">
                                    <Image.Source>
                                        <BitmapImage UriSource="{Binding CoverImageUrl}" 
                                                     CreateOptions="BackgroundCreation" 
                                                     DecodePixelWidth="200"/>
                                    </Image.Source>
                                </Image>

                                <Border VerticalAlignment="Bottom" Background="#B2000000" Padding="8,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" 
                                                   FontWeight="Bold" 
                                                   FontSize="20" 
                                                   Foreground="White"
                                                   TextTrimming="WordEllipsis"/>
                                        <TextBlock Text="{Binding PinsCount, StringFormat='{}{0} pins'}" 
                                                   Opacity="0.85" 
                                                   FontSize="14" 
                                                   Foreground="White"
                                                   Style="{StaticResource PhoneTextSubtleStyle}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </phone:LongListSelector.ItemTemplate>
                </phone:LongListSelector>
            </phone:PanoramaItem>

            <!-- СЕКЦИЯ 3: Поиск -->
            <phone:PanoramaItem Header="{Binding Path=LocalizedResources.PanoramaSearch, Source={StaticResource LocalizedStrings}}" Width="380">
                <Grid Margin="12,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <toolkit:PhoneTextBox x:Name="SearchBox"
                                          Grid.Row="0"
                                          Margin="-12,-8,-12,12"
                                          Hint="{Binding Path=LocalizedResources.SearchHint, Source={StaticResource LocalizedStrings}}"
                                          InputScope="Search"
                                          TextChanged="OnSearchTextChanged"/>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,4,0,24">

                            <TextBlock x:Name="SearchEmptyState"
                                       Text="{Binding Path=LocalizedResources.SearchEmptyState, Source={StaticResource LocalizedStrings}}"
                                       Style="{StaticResource PhoneTextSubtleStyle}"
                                       Margin="0,16,0,0"/>

                            <StackPanel x:Name="FoundBoardsHeaderPanel" Visibility="Collapsed" Margin="0,0,0,20">
                                <TextBlock Text="{Binding Path=LocalizedResources.PanoramaBoards, Source={StaticResource LocalizedStrings}}" 
                                           Style="{StaticResource PhoneTextGroupHeaderStyle}" 
                                           Margin="0,0,0,8"/>

                                <ItemsControl x:Name="FoundBoardsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,14" Tap="OnFoundBoardTap">
                                                <TextBlock Text="{Binding Name}" 
                                                    FontSize="24" 
                                                    FontWeight="Normal" 
                                                    Foreground="{StaticResource PhoneForegroundBrush}"
                                                    TextTrimming="WordEllipsis"/>
                                                <TextBlock Text="{Binding PinsCount, StringFormat='{}{0} pins'}" 
                                                    Style="{StaticResource PhoneTextSubtleStyle}" 
                                                    FontSize="14"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel x:Name="FoundPinsHeaderPanel" Visibility="Collapsed">
                                <TextBlock Text="{Binding Path=LocalizedResources.PanoramaFeed, Source={StaticResource LocalizedStrings}}" 
                                           Style="{StaticResource PhoneTextGroupHeaderStyle}" 
                                           Margin="0,0,0,12"/>

                                <ItemsControl x:Name="FoundPinsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,20" Tap="OnFoundPinTap">
                                                <Rectangle Width="340" Height="220" HorizontalAlignment="Left">
                                                    <Rectangle.Fill>
                                                        <ImageBrush Stretch="UniformToFill">
                                                            <ImageBrush.ImageSource>
                                                                <BitmapImage UriSource="{Binding DisplayThumbnailUrl}" 
                                                                             CreateOptions="BackgroundCreation" 
                                                                             DecodePixelWidth="340"/>
                                                            </ImageBrush.ImageSource>
                                                        </ImageBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                                <TextBlock Text="{Binding Description}" 
                                                           Style="{StaticResource PhoneTextNormalStyle}"
                                                           Margin="0,8,0,0"
                                                           MaxHeight="40"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="WordEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </phone:PanoramaItem>

            <!-- СЕКЦИЯ 4: Профиль пользователя -->
            <phone:PanoramaItem Header="{Binding Path=LocalizedResources.PanoramaMe, Source={StaticResource LocalizedStrings}}" Width="440">
                <Grid Margin="12,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,16,10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="64" Height="64" Background="{StaticResource PhoneAccentBrush}">
                                <Image Source="{Binding CurrentUser.LocalAvatar}" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUser.Username}" Style="{StaticResource PhoneTextTitle2Style}"/>
                                <TextBlock Text="{Binding CurrentUser.Email}" Style="{StaticResource PhoneTextSubtleStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Background="#1AFFFFFF" 
                                Padding="10,8" 
                                Margin="0,0,0,8"
                                Tap="OnTokenTap">
                            <StackPanel>
                                <TextBlock Text="{Binding Path=LocalizedResources.ApiTokenTapToCopy, Source={StaticResource LocalizedStrings}}" 
                                           Style="{StaticResource PhoneTextSubtleStyle}" 
                                           FontSize="11"/>
                                <TextBlock Text="{Binding CurrentUser.Token}" 
                                           FontFamily="Courier New"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Opacity="0.85"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding Path=LocalizedResources.MyBoards, Source={StaticResource LocalizedStrings}}" 
                                   Style="{StaticResource PhoneTextGroupHeaderStyle}" 
                                   Margin="0,4,0,2"/>
                    </StackPanel>

                    <phone:LongListSelector Grid.Row="1"
                                            ItemsSource="{Binding UserBoardsWithAll}"
                                            LayoutMode="Grid"
                                            IsGroupingEnabled="False"
                                            GridCellSize="195,195"
                                            SelectionChanged="OnMyBoardSelectionChanged">
                        <phone:LongListSelector.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="185" Height="185" 
                                      Margin="0,0,10,10" 
                                      Background="{StaticResource PhoneAccentBrush}"
                                      toolkit:TiltEffect.SuppressTilt="True"
                                      Hold="OnItemHold">
                                    <toolkit:ContextMenuService.ContextMenu>
                                        <toolkit:ContextMenu Opened="OnContextMenuOpened">
                                            <toolkit:MenuItem Header="{Binding Path=LocalizedResources.Edit, Source={StaticResource LocalizedStrings}}" Click="OnEditBoardContextClick"/>
                                            <toolkit:MenuItem Header="{Binding Path=LocalizedResources.Delete, Source={StaticResource LocalizedStrings}}" Click="OnDeleteBoardContextClick"/>
                                        </toolkit:ContextMenu>
                                    </toolkit:ContextMenuService.ContextMenu>

                                    <Image Stretch="UniformToFill">
                                        <Image.Source>
                                            <BitmapImage UriSource="{Binding CoverImageUrl}" 
                                                         CreateOptions="BackgroundCreation" 
                                                         DecodePixelWidth="200"/>
                                        </Image.Source>
                                    </Image>

                                    <Border VerticalAlignment="Bottom" Background="#B2000000" Padding="8,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" 
                                                       FontWeight="Bold" 
                                                       FontSize="18" 
                                                       Foreground="White"
                                                       TextTrimming="WordEllipsis"/>
                                            <TextBlock Text="{Binding PinsCount, StringFormat='{}{0} pins'}" 
                                                       Opacity="0.85" 
                                                       FontSize="13" 
                                                       Foreground="White"
                                                       Style="{StaticResource PhoneTextSubtleStyle}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </phone:LongListSelector.ItemTemplate>
                    </phone:LongListSelector>
                </Grid>
            </phone:PanoramaItem>
        </phone:Panorama>
    </Grid>

    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar IsVisible="True" IsMenuEnabled="True" Mode="Default" Opacity="0.99">
            <shell:ApplicationBarIconButton IconUri="/Assets/AppBar/pin.png" Text="add" Click="OnAddAppBarClick"/>
            <shell:ApplicationBarIconButton IconUri="/Assets/AppBar/refresh.png" Text="refresh" Click="OnRefreshAppBarClick"/>
            <shell:ApplicationBar.MenuItems>
                <shell:ApplicationBarMenuItem Text="manage accounts" Click="OnAccountsAppBarClick"/>
                <shell:ApplicationBarMenuItem Text="add account" Click="OnAddAccountMenuClick"/>
                <shell:ApplicationBarMenuItem Text="switch language" Click="OnSwitchLanguageMenuClick"/>
                <shell:ApplicationBarMenuItem Text="sign out" Click="OnSignOutMenuClick"/>
            </shell:ApplicationBar.MenuItems>
        </shell:ApplicationBar>
    </phone:PhoneApplicationPage.ApplicationBar>

</phone:PhoneApplicationPage>