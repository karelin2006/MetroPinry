<phone:PhoneApplicationPage
    x:Class="MetroPinry.Views.BoardDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True">

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок страницы в нижнем регистре (канон Metro) -->
        <StackPanel Grid.Row="0" Margin="18,17,0,20">
            <TextBlock Text="board" Style="{StaticResource PhoneTextNormalStyle}"/>
            <TextBlock x:Name="BoardTitle" Text="name" Margin="0,-7,0,0" Style="{StaticResource PhoneTextTitle1Style}"/>
        </StackPanel>

        <!-- Сетка пинов 2x2 внутри выбранной доски -->
        <phone:LongListSelector x:Name="BoardPinsList" 
                                Grid.Row="1" 
                                Margin="18,0,0,0"
                                LayoutMode="Grid"
                                GridCellSize="224,224"
                                SelectionChanged="OnPinSelectionChanged">
            <phone:LongListSelector.ItemTemplate>
                <DataTemplate>
                    <Grid Width="212" Height="212" 
                          Margin="0,0,12,12" 
                          Background="#1AFFFFFF">

                        <!-- Квадратная картинка пина -->
                        <Image Stretch="UniformToFill">
                            <Image.Source>
                                <BitmapImage UriSource="{Binding DisplayThumbnailUrl}" CreateOptions="BackgroundCreation"/>
                            </Image.Source>
                        </Image>

                        <!-- Полупрозрачная плашка с описанием снизу (если текст есть) -->
                        <Border VerticalAlignment="Bottom" Background="#B2000000" Padding="8,6">
                            <TextBlock Text="{Binding Description}" 
                                       FontSize="14"
                                       Foreground="White"
                                       MaxHeight="36"
                                       TextWrapping="Wrap"
                                       TextTrimming="WordEllipsis"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </phone:LongListSelector.ItemTemplate>

            <!-- Маркер конца списка пинов в доске -->
            <phone:LongListSelector.ListFooterTemplate>
                <DataTemplate>
                    <StackPanel HorizontalAlignment="Center" Margin="0,16,18,36" Width="444">
                        <TextBlock Text="— that's all folks —" 
                                   FontSize="14"
                                   FontWeight="Light"
                                   Foreground="#66FFFFFF"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </phone:LongListSelector.ListFooterTemplate>
        </phone:LongListSelector>
    </Grid>

</phone:PhoneApplicationPage>