<phone:PhoneApplicationPage
    x:Class="MetroPinry.Views.NewPinPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True">

    <shell:SystemTray.ProgressIndicator>
        <shell:ProgressIndicator x:Name="PinProgressIndicator" 
                                 IsVisible="False" 
                                 IsIndeterminate="True" 
                                 Text="{Binding Path=LocalizedResources.AppTitle, Source={StaticResource LocalizedStrings}}"/>
    </shell:SystemTray.ProgressIndicator>

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="18,17,0,10">
            <TextBlock Text="{Binding Path=LocalizedResources.AppTitle, Source={StaticResource LocalizedStrings}}" Style="{StaticResource PhoneTextNormalStyle}"/>
            <TextBlock x:Name="PageTitle" Text="{Binding Path=LocalizedResources.AddPin, Source={StaticResource LocalizedStrings}}" Margin="0,-7,0,0" Style="{StaticResource PhoneTextTitle1Style}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="12,0,12,0">
            <StackPanel Margin="6,0,6,24">

                <Border Width="200" Height="200" Background="#1AFFFFFF" HorizontalAlignment="Left" Margin="6,0,0,16">
                    <Grid>
                        <TextBlock x:Name="PlaceholderText" 
                                   Text="{Binding Path=LocalizedResources.NoImageSelected, Source={StaticResource LocalizedStrings}}" 
                                   Style="{StaticResource PhoneTextSubtleStyle}" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"/>
                        <Image x:Name="ImagePreview" Stretch="UniformToFill" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- Кнопки выбора и сброса фото -->
                <Grid Margin="-6,0,-6,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnPickImage" 
                            Content="{Binding Path=LocalizedResources.ChooseFromGallery, Source={StaticResource LocalizedStrings}}" 
                            Click="OnPickImageClick" 
                            Margin="0,0,6,0"/>
                    <Button x:Name="BtnClearImage" 
                            Grid.Column="1" 
                            Content="{Binding Path=LocalizedResources.Clear, Source={StaticResource LocalizedStrings}}" 
                            Click="OnClearImageClick" 
                            Visibility="Collapsed"/>
                </Grid>

                <TextBlock Text="{Binding Path=LocalizedResources.ImageUrl, Source={StaticResource LocalizedStrings}}" Style="{StaticResource PhoneTextSubtleStyle}" Margin="6,4,0,0"/>
                <TextBox x:Name="TxtImageUrl" InputScope="Url" TextChanged="OnImageUrlChanged" Margin="-6,0,-6,8"/>

                <TextBlock Text="{Binding Path=LocalizedResources.Description, Source={StaticResource LocalizedStrings}}" Style="{StaticResource PhoneTextSubtleStyle}" Margin="6,4,0,0"/>
                <TextBox x:Name="TxtDescription" TextWrapping="Wrap" AcceptsReturn="True" Height="90" Margin="-6,0,-6,8"/>

                <TextBlock Text="{Binding Path=LocalizedResources.TagsInputHint, Source={StaticResource LocalizedStrings}}" Style="{StaticResource PhoneTextSubtleStyle}" Margin="6,4,0,0"/>
                <TextBox x:Name="TxtTags" 
                         TextChanged="OnTagsTextChanged" 
                         Margin="-6,0,-6,0"/>

                <!-- Выпадающий список совпадений для ручного выбора пальцем -->
                <Border x:Name="TagsPopupBorder" 
                        Background="{StaticResource PhoneChromeBrush}" 
                        BorderBrush="{StaticResource PhoneSubtleBrush}" 
                        BorderThickness="1" 
                        Margin="0,0,0,8" 
                        MaxHeight="180" 
                        Visibility="Collapsed">
                    <ListBox x:Name="SuggestedTagsList" 
                             SelectionChanged="OnSuggestedTagTap">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10">
                                    <TextBlock Text="{Binding}" 
                                               FontSize="20" 
                                               Foreground="{StaticResource PhoneForegroundBrush}"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Выбор доски и кнопка "Создать доску" (скрываются при редактировании) -->
                <StackPanel x:Name="BoardSelectionPanel" Margin="0,8,0,0">
                    <TextBlock Text="{Binding Path=LocalizedResources.BoardLabel, Source={StaticResource LocalizedStrings}}" 
                               Style="{StaticResource PhoneTextSubtleStyle}" 
                               Margin="6,0,0,0"/>

                    <toolkit:ListPicker x:Name="BoardPicker" DisplayMemberPath="Name" Margin="6,0,6,0"/>

                    <Button x:Name="BtnCreateBoard"
                            Content="{Binding Path=LocalizedResources.CreateBoardButton, Source={StaticResource LocalizedStrings}}" 
                            Click="OnCreateNewBoardClick" 
                            Margin="-6,0,-6,12"/>
                </StackPanel>

                <CheckBox x:Name="ChkIsPrivate" 
                          Content="{Binding Path=LocalizedResources.PrivatePinOption, Source={StaticResource LocalizedStrings}}" 
                          Margin="-12,0,0,12"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>

    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar IsVisible="True" IsMenuEnabled="False">
            <shell:ApplicationBarIconButton IconUri="/Assets/AppBar/upload.png" Text="save" Click="OnSaveAppBarClick"/>
            <shell:ApplicationBarIconButton IconUri="/Assets/AppBar/cancel.png" Text="cancel" Click="OnCancelAppBarClick"/>
        </shell:ApplicationBar>
    </phone:PhoneApplicationPage.ApplicationBar>

</phone:PhoneApplicationPage>