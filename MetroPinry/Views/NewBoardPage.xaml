<phone:PhoneApplicationPage
    x:Class="MetroPinry.Views.NewBoardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True">

    <shell:SystemTray.ProgressIndicator>
        <shell:ProgressIndicator x:Name="BoardProgressIndicator" 
                                 IsVisible="False" 
                                 IsIndeterminate="True" 
                                 Text="{Binding Path=LocalizedResources.AppTitle, Source={StaticResource LocalizedStrings}}"/>
    </shell:SystemTray.ProgressIndicator>

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="18,17,0,10">
            <TextBlock Text="{Binding Path=LocalizedResources.AppTitle, Source={StaticResource LocalizedStrings}}" Style="{StaticResource PhoneTextNormalStyle}"/>
            <TextBlock x:Name="PageTitle" Text="{Binding Path=LocalizedResources.CreateBoard, Source={StaticResource LocalizedStrings}}" Margin="0,-7,0,0" Style="{StaticResource PhoneTextTitle1Style}"/>
        </StackPanel>

        <!-- Форма -->
        <ScrollViewer Grid.Row="1" Margin="12,0,12,0">
            <StackPanel Margin="6,24,6,24">

                <!-- Название доски -->
                <TextBlock Text="{Binding Path=LocalizedResources.BoardName, Source={StaticResource LocalizedStrings}}" Style="{StaticResource PhoneTextSubtleStyle}" Margin="6,0,0,0"/>
                <TextBox x:Name="TxtBoardName" 
                         Margin="-6,0,-6,24"
                         MaxLength="100"/>

                <!-- Опция скрытой доски -->
                <CheckBox x:Name="ChkIsPrivate" 
                          Content="{Binding Path=LocalizedResources.PrivateBoardOption, Source={StaticResource LocalizedStrings}}" 
                          Margin="-12,0,0,12"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>

    <!-- ApplicationBar -->
    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar IsVisible="True" IsMenuEnabled="False">
            <shell:ApplicationBarIconButton IconUri="/Assets/AppBar/upload.png" 
                                           Text="save" 
                                           Click="OnSaveAppBarClick"/>
            <shell:ApplicationBarIconButton IconUri="/Assets/AppBar/cancel.png" 
                                           Text="cancel" 
                                           Click="OnCancelAppBarClick"/>
        </shell:ApplicationBar>
    </phone:PhoneApplicationPage.ApplicationBar>

</phone:PhoneApplicationPage>