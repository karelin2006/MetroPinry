<phone:PhoneApplicationPage
    x:Class="MetroPinry.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True">

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ProgressBar x:Name="LoginProgressBar" VerticalAlignment="Top" IsIndeterminate="True" Visibility="Collapsed" Margin="0" Foreground="{StaticResource PhoneAccentBrush}"/>

        <StackPanel Grid.Row="0" Margin="24,17,0,18">
            <TextBlock Text="METROPINRY" Style="{StaticResource PhoneTextNormalStyle}"/>
            <TextBlock x:Name="PageTitle" Text="sign in" Margin="-3,-7,0,0" Style="{StaticResource PhoneTextTitle1Style}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="24,0,24,24">

                <!-- БЛОК 1: СОХРАНЕННЫЕ АККАУНТЫ ДЛЯ БЫСТРОГО ВХОДА -->
                <StackPanel x:Name="SavedAccountsSection" Visibility="Collapsed" Margin="0,0,0,16">
                    <TextBlock Text="choose account" Style="{StaticResource PhoneTextGroupHeaderStyle}" Margin="-12,0,0,8"/>

                    <ItemsControl x:Name="SavedAccountsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="-12,0,-12,10" 
                                        Background="#1AFFFFFF" 
                                        Padding="10,8"
                                        toolkit:TiltEffect.SuppressTilt="False"
                                        Tap="OnSavedAccountTap">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="48" Height="48" Background="{StaticResource PhoneAccentBrush}">
                                            <Image Source="{Binding LocalAvatar}" Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Username}" 
                                                       Style="{StaticResource PhoneTextLargeStyle}" 
                                                       FontSize="20"
                                                       Margin="0"
                                                       TextTrimming="WordEllipsis"/>
                                            <TextBlock Text="{Binding ServerUrl}" 
                                                       Style="{StaticResource PhoneTextSubtleStyle}" 
                                                       FontSize="12"
                                                       Margin="0"
                                                       TextTrimming="WordEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="or enter credentials" Style="{StaticResource PhoneTextGroupHeaderStyle}" Margin="-12,12,0,8"/>
                </StackPanel>

                <!-- БЛОК 2: ФОРМА ВВОДА -->
                <!-- Адрес сервера -->
                <Grid Margin="-12,0,-12,12">
                    <TextBox x:Name="ServerUrlBox" Text="https://" InputScope="Url" TextChanged="TextBox_TextChanged"/>
                    <TextBlock x:Name="ServerUrlHint" Text="server address" Style="{StaticResource PhoneTextSubtleStyle}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="14,-2,0,0" Visibility="Collapsed"/>
                </Grid>

                <StackPanel x:Name="CredentialsPanel">
                    <!-- Логин -->
                    <Grid Margin="-12,0,-12,12">
                        <TextBox x:Name="UsernameBox" InputScope="PersonalFullName" TextChanged="TextBox_TextChanged"/>
                        <TextBlock x:Name="UsernameHint" Text="username" Style="{StaticResource PhoneTextSubtleStyle}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="14,-2,0,0"/>
                    </Grid>

                    <!-- Email (для регистрации) -->
                    <StackPanel x:Name="EmailPanel" Visibility="Collapsed">
                        <Grid Margin="-12,0,-12,12">
                            <TextBox x:Name="EmailBox" InputScope="EmailSmtpAddress" TextChanged="TextBox_TextChanged"/>
                            <TextBlock x:Name="EmailHint" Text="email" Style="{StaticResource PhoneTextSubtleStyle}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="14,-2,0,0"/>
                        </Grid>
                    </StackPanel>

                    <!-- Пароль -->
                    <Grid Margin="-12,0,-12,12">
                        <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"/>
                        <TextBlock x:Name="PasswordHint" Text="password" Style="{StaticResource PhoneTextSubtleStyle}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="14,-2,0,0"/>
                    </Grid>

                    <!-- Повтор пароля (только для регистрации) -->
                    <StackPanel x:Name="PasswordRepeatPanel" Visibility="Collapsed">
                        <Grid Margin="-12,0,-12,12">
                            <PasswordBox x:Name="PasswordRepeatBox" PasswordChanged="PasswordRepeatBox_PasswordChanged"/>
                            <TextBlock x:Name="PasswordRepeatHint" Text="repeat password" Style="{StaticResource PhoneTextSubtleStyle}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="14,-2,0,0"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- Токен -->
                <StackPanel x:Name="TokenPanel" Visibility="Collapsed">
                    <Grid Margin="-12,0,-12,12">
                        <TextBox x:Name="TokenBox" TextChanged="TextBox_TextChanged"/>
                        <TextBlock x:Name="TokenHint" Text="api token" Style="{StaticResource PhoneTextSubtleStyle}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="14,-2,0,0"/>
                    </Grid>
                </StackPanel>

                <Button x:Name="ActionBtn" Content="sign in" Margin="-12,0,-12,12" BorderThickness="2" Click="OnActionBtnClick"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar Mode="Minimized" Opacity="0.99" IsMenuEnabled="True">
            <shell:ApplicationBar.MenuItems>
                <shell:ApplicationBarMenuItem Text="create account" Click="OnToggleModeClick" />
                <shell:ApplicationBarMenuItem Text="use api token" Click="OnSwitchAuthModeClick" />
                <shell:ApplicationBarMenuItem Text="browse as guest" Click="OnGuestModeClick" />
                <shell:ApplicationBarMenuItem Text="manage accounts" Click="OnManageAccountsClick" />
            </shell:ApplicationBar.MenuItems>
        </shell:ApplicationBar>
    </phone:PhoneApplicationPage.ApplicationBar>

</phone:PhoneApplicationPage>