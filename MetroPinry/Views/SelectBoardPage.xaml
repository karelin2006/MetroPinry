<phone:PhoneApplicationPage
    x:Class="MetroPinry.Views.SelectBoardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True">

    <shell:SystemTray.ProgressIndicator>
        <shell:ProgressIndicator x:Name="PageProgress" IsVisible="False" IsIndeterminate="True"/>
    </shell:SystemTray.ProgressIndicator>

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок в стиле Windows Phone -->
        <StackPanel Grid.Row="0" Margin="12,17,0,28">
            <TextBlock Text="{Binding Path=LocalizedResources.ApplicationTitle, Source={StaticResource LocalizedStrings}}" Style="{StaticResource PhoneTextNormalStyle}"/>
            <TextBlock x:Name="PageHeader" Text="{Binding Path=LocalizedResources.SelectBoard, Source={StaticResource LocalizedStrings}}" Margin="9,-7,0,0" Style="{StaticResource PhoneTextTitle1Style}"/>
        </StackPanel>

        <!-- Крупный список досок в стиле Metro Full Mode ListPicker -->
        <phone:LongListSelector x:Name="BoardsList" 
                                Grid.Row="1" 
                                Margin="12,0,0,0"
                                SelectionChanged="OnBoardSelectionChanged">
            <phone:LongListSelector.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12,14" Margin="0,0,16,10" Background="#1AFFFFFF">
                        <TextBlock Text="{Binding Name}" 
                                   FontSize="28" 
                                   FontWeight="Light"
                                   TextTrimming="WordEllipsis"/>
                    </Border>
                </DataTemplate>
            </phone:LongListSelector.ItemTemplate>
        </phone:LongListSelector>
    </Grid>
</phone:PhoneApplicationPage>