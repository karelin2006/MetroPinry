<phone:PhoneApplicationPage
    x:Class="MetroPinry.Views.PinDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="PortraitOrLandscape" Orientation="Portrait"
    shell:SystemTray.IsVisible="True">

    <shell:SystemTray.ProgressIndicator>
        <shell:ProgressIndicator x:Name="AppProgressIndicator" 
                                 IsVisible="False" 
                                 IsIndeterminate="True" 
                                 Text="MetroPinry"/>
    </shell:SystemTray.ProgressIndicator>

    <Grid x:Name="LayoutRoot" Background="{StaticResource PhoneBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,12,18,30">

                <Border Background="#FF000000" 
                        Margin="0,0,0,16" 
                        HorizontalAlignment="Center" 
                        MaxWidth="444">
                    <Image x:Name="FullImage"
                           Stretch="Uniform"
                           MaxWidth="444"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                </Border>

                <TextBlock x:Name="PinDescription"
                           Text="Описание"
                           Style="{StaticResource PhoneTextTitle2Style}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"/>

                <Rectangle Height="1" Fill="#33FFFFFF" Margin="0,0,0,16"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Автор -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="автор" Style="{StaticResource PhoneTextSubtleStyle}" Margin="0,0,12,8"/>
                    <TextBlock x:Name="TxtAuthor" Grid.Row="0" Grid.Column="1" Text="—" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <!-- Теги -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="теги" Style="{StaticResource PhoneTextSubtleStyle}" Margin="0,0,12,8"/>
                    <TextBlock x:Name="TxtTags" Grid.Row="1" Grid.Column="1" Text="—" Foreground="{StaticResource PhoneAccentBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <!-- Доступ -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="доступ" Style="{StaticResource PhoneTextSubtleStyle}" Margin="0,0,12,8"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock x:Name="TxtVisibilityIcon" FontFamily="Segoe UI Symbol" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtVisibility" Text="—" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Доски: только текст названий -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="доски" Style="{StaticResource PhoneTextSubtleStyle}" Margin="0,0,12,8"/>
                    <TextBlock x:Name="TxtBoards" Grid.Row="3" Grid.Column="1" Text="—" TextWrapping="Wrap" Margin="0,0,0,8"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>

    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar IsVisible="True" IsMenuEnabled="True" Mode="Default">
            <shell:ApplicationBarIconButton IconUri="/Assets/AppBar/edit.png" Text="edit" Click="OnEditAppBarClick"/>
            <shell:ApplicationBarIconButton IconUri="/Assets/AppBar/download.png" Text="download" Click="OnDownloadAppBarClick"/>
            <shell:ApplicationBarIconButton IconUri="/Assets/AppBar/delete.png" Text="delete" Click="OnDeleteAppBarClick"/>
            <shell:ApplicationBar.MenuItems>
                <shell:ApplicationBarMenuItem Text="прикрепить к доске..." Click="OnAttachBoardMenuClick"/>
                <shell:ApplicationBarMenuItem Text="открепить от доски..." Click="OnDetachBoardMenuClick"/>
            </shell:ApplicationBar.MenuItems>
        </shell:ApplicationBar>
    </phone:PhoneApplicationPage.ApplicationBar>

</phone:PhoneApplicationPage>